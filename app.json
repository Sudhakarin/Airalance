{
  "expo": {
    "name": "Airalance",
    "slug": "airalance-new",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "airalance",
    "userInterfaceStyle": "dark",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.airalance.app",
      "buildNumber": "1",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Airalance needs microphone access to send voice messages and make calls.",
        "NSCameraUsageDescription": "Airalance needs camera access for video calls.",
        "UIBackgroundModes": [
          "audio",
          "voip",
          "remote-notification"
        ]
      }
    },
    "android": {
      "package": "com.airalance.app",
      "versionCode": 1,
      "googleServicesFile": "./google-services.json",
      "edgeToEdgeEnabled": false,
      "permissions": [
        "NOTIFICATIONS",
        "POST_NOTIFICATIONS",
        "VIBRATE",
        "RECORD_AUDIO",
        "CAMERA",
        "MODIFY_AUDIO_SETTINGS",
        "BLUETOOTH",
        "BLUETOOTH_CONNECT",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_PHONE_CALL",
        "FOREGROUND_SERVICE_MICROPHONE",
        "CALL_PHONE",
        "ANSWER_PHONE_CALLS",
        "MANAGE_OWN_CALLS",
        "READ_PHONE_STATE",
        "READ_PHONE_NUMBERS",
        "USE_FULL_SCREEN_INTENT",
        "WAKE_LOCK",
        "DISABLE_KEYGUARD",
        "REQUEST_IGNORE_BATTERY_OPTIMIZATIONS",
        "SYSTEM_ALERT_WINDOW"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#000000"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-notifications",
      [
        "expo-audio",
        {
          "microphonePermission": "Allow Airalance to access your microphone."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#000000"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "buildArchs": [
              "arm64-v8a"
            ],
            "minSdkVersion": 24,
            "compileSdkVersion": 35,
            "targetSdkVersion": 35,
            "usesCleartextTraffic": true
          },
          "ios": {
            "deploymentTarget": "15.1"
          }
        }
      ],
      "expo-video",
      "expo-sqlite",
      "@config-plugins/react-native-webrtc",
      "@react-native-firebase/app"
",
      "@react-native   -firebase },
/messaging",
      "./plugins/withCallKeep"
       ],
    "updates": " {
      "url": "httpsextra://u.expo.dev/a29b4ab7-af7a-401f-a49d-4326fd746007",
      "fallbackToCacheTimeout": 0,
      "checkAutomatically": "ON_LOAD"
    },
    "runtimeVersion": {
      "policy": "appVersion": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "a29b4ab7-af7a-401f-a49d-4326fd746007"
      }
    },
    "experiments": {
      "typedRoutes": false
    },
    "owner": "airalanceapps-team"
  }
}
