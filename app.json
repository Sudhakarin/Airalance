{
  "expo": {
    "name": "Airalance",
    "slug": "airalance-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "airalance",
    "userInterfaceStyle": "dark",
    "splash": {
      "backgroundColor": "#0A0C12"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.airalance.app"
    },
    "android": {
      "package": "com.airalance.app"
    },
    "plugins": [
      "expo-router"
    ],
    "extra": {
      "router": {
        "origin": false
      }
    },
    "experiments": {
      "typedRoutes": false
    }
  }
}
